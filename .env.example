APP_NAME=Warehouse Agent
APP_ENV=dev
APP_DATABASE_URL=sqlite:///./data/warehouse_agent.db
APP_MOCK_EXTERNAL=true
APP_SECRET_KEY=change-me-in-production
APP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# DolphinScheduler 导出的现有代码，只读使用。
APP_SOURCE_ROOT=./data/source
# Agent 每个研发任务的独立可写目录。
APP_WORKSPACE_ROOT=./data/workspaces
# 人工验收通过后生成发布包，不自动回写 DolphinScheduler。
APP_RELEASE_ROOT=./data/releases

APP_DS_SQL_TASK_TYPES=SQL
APP_DS_QUERY_TIMEOUT_SECONDS=30
